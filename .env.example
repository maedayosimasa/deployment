# bim-aiagent01 と Legal Knowledge Builder を1台のホスト(EC2等)上で連携
# 起動するための、秘密情報・接続設定の一元管理ファイル。
# 実際の値を入れた .env をこのファイルと同じ場所に作成すること(.envはコミットしない)。
#
# compose.yaml/compose.prod.yamlは`include:`で2つのリポジトリのdocker-compose.ymlを
# 取り込んでいるが、変数展開(${VAR})はプロジェクト全体で1つの環境として扱われる
# ため、ここで定義した値がinclude先のファイル内の${VAR}参照にもそのまま使われる。

# 両ファイルを自動的にまとめて読み込ませる場合はコメントを外す
# (外さない場合は `docker compose -f compose.yaml -f compose.prod.yaml up -d` と
# 明示的に指定する)。
# COMPOSE_FILE=compose.yaml:compose.prod.yaml

# --- ディレクトリ配置 ---
# Legal Knowledge Builderのチェックアウト先ディレクトリ名(deployment/から見た
# 相対パス)。EC2ではスペースを含まない kebab-case (legal-knowledge-builder) で
# cloneすることを推奨(Dockerのビルドコンテキスト・シェルスクリプトでの
# クォート漏れ事故を避けるため)。このWSL開発環境のように元のリポジトリ名
# (スペース入り、"Legal Knowledge Builder")のままの場合はこちらを上書きする。
#
# 注意: Docker Composeバージョンによってはinclude:のパス内での変数展開が
# 期待通り動かないことが既知の問題として報告されている。もし
# `docker compose config` で解決先が意図通りにならない場合は、この変数に
# 頼らずディレクトリ名をデフォルト値(legal-knowledge-builder)に合わせて
# リネーム/シンボリックリンクする方が確実。
LKB_DIR=../legal-knowledge-builder

# --- bim-aiagent01 (詳細は ../bim-aiagent01/.env.example 参照) ---
TS_AUTHKEY=
ARCHICAD_MCP_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_AGENT_MODEL=
LAND_USE_CATEGORY=

# フロントエンドの実際の配信元オリジン(compose.proxy.yaml利用時はCaddy経由の
# 本番ドメイン)。カンマ区切りで複数可。
# 例: https://bim-aiagent.com,https://www.bim-aiagent.com
# compose.prod.yamlのbackend.CORS_ALLOWED_ORIGINSに渡される。
FRONTEND_ORIGIN=

# ブラウザから見たbackendの公開URL(frontend/src/api/client.ts参照)。
# compose.proxy.yaml(Caddy)利用時はポート番号無しの api.<DOMAIN> を指定する
# (Caddyが443→backendの8000へ中継するため)。例: https://api.bim-aiagent.com
# FRONTEND_ORIGINと同じEC2ホストを指すが別の値のため手動で両方設定する必要が
# ある(自動導出はしていない)。ブラウザ側で評価される値のため、backendのコンテナ名
# (legal-knowledge-builderとの通信で使っているようなDocker内部DNS)では届かない。
# compose.prod.yamlのfrontend.VITE_API_BASE_URLに渡される。
BACKEND_PUBLIC_URL=

# --- リバースプロキシ / TLS (Caddy, compose.proxy.yaml。実ドメインで公開する場合のみ) ---
# 例: bim-aiagent.com。事前にDNSのAレコードで <DOMAIN>・www.<DOMAIN>・
# api.<DOMAIN> の3つをすべてこのホストのグローバルIP(Elastic IP推奨)へ
# 向けておくこと(Let's EncryptのHTTP-01チャレンジのため)。
DOMAIN=
# Let's Encrypt証明書発行の通知先メールアドレス(失効間近等の通知用、任意だが推奨)。
CADDY_EMAIL=
# backendにアプリケーション認証が無いため、Caddy側でBasic認証をかけて
# frontend/api両方を保護する(Caddyfile参照)。ユーザー名は任意の文字列。
CADDY_BASIC_AUTH_USER=
# 上記ユーザーのパスワードのbcryptハッシュ(平文パスワードはここに書かない)。
# EC2上で以下のように生成し、出力された $2a$... 形式の文字列をそのまま貼る:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '実際のパスワード'
# ($を含む文字列だが、.envファイル自体はdocker composeによる${VAR}展開の対象外
# なのでエスケープ不要。そのまま1行で貼ってよい)
CADDY_BASIC_AUTH_HASH=
# frontendのVite dev serverが受け付けるHostヘッダ(カンマ区切り)。
# DOMAINと同じ値+wwwを指定する。例: bim-aiagent.com,www.bim-aiagent.com
# (未設定だとリバースプロキシ経由のアクセスが全て403 "Blocked request"になる。
# bim-aiagent01/frontend/vite.config.ts参照)
VITE_ALLOWED_HOSTS=

# --- Legal Knowledge Builder (詳細は ../legal-knowledge-builder/.env.example 参照) ---
# postgres/neo4jは検索API(legal-knowledge-builderサービス)自体は使わない
# (既定の検索経路はファイルベースのChromaDBのみで完結する)。将来pgvector/
# GraphRAGの書き込みを本番でも行いたくなった場合のみ値を設定する。
POSTGRES_USER=lkb
POSTGRES_PASSWORD=lkb
POSTGRES_DB=legal_knowledge_builder
NEO4J_AUTH=neo4j/lkb_password
